{
 "datasets": [
  {
   "name": "ds_encounters",
   "displayName": "encounters",
   "queryLines": [
    "SELECT *,\n",
    "       CASE WHEN encounter_class = 'IMP' THEN length_of_stay_days END AS inpatient_los_days,\n",
    "       CASE WHEN readmitted_within_30d THEN 1 ELSE 0 END AS readmission_flag\n",
    "FROM health.gold.vw_encounter_analytics\n",
    "WHERE admit_year >= 2015"
   ]
  },
  {
   "name": "ds_diagnoses",
   "displayName": "diagnoses",
   "queryLines": [
    "SELECT * FROM health.gold.vw_encounter_diagnoses WHERE admit_year >= 2015"
   ]
  }
 ],
