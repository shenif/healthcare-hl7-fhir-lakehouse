          {
           "name": "sourceName",
           "expression": "`source_systems`"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "frame": {
        "showTitle": true,
        "title": "Encounters by source system"
       },
       "jsonSpec": {
        "spec": "{\"$schema\": \"https://vega.github.io/schema/vega-lite/v6.json\", \"data\": {\"name\": \"databricks_query\"}, \"width\": \"container\", \"height\": \"container\", \"config\": {\"autosize\": {\"type\": \"fit\", \"contains\": \"padding\"}}, \"transform\": [{\"window\": [{\"op\": \"sum\", \"field\": \"encounterCount\", \"as\": \"total\"}]}, {\"calculate\": \"datum.encounterCount / datum.total\", \"as\": \"pct\"}], \"layer\": [{\"mark\": {\"type\": \"arc\", \"innerRadius\": 60, \"outerRadius\": 110}, \"encoding\": {\"theta\": {\"field\": \"encounterCount\", \"type\": \"quantitative\"}, \"color\": {\"field\": \"sourceName\", \"type\": \"nominal\", \"legend\": {\"title\": \"Reported by\"}}}}, {\"mark\": {\"type\": \"text\", \"radius\": 85, \"fontSize\": 12, \"fill\": {\"expr\": \"colors.textPrimary.default\"}}, \"encoding\": {\"theta\": {\"field\": \"encounterCount\", \"type\": \"quantitative\"}, \"text\": {\"field\": \"pct\", \"type\": \"quantitative\", \"format\": \".1%\"}}}]}",
        "type": "vega-lite"
       },
       "version": 1,
       "widgetType": "custom-vega-viz",
       "encodings": {
        "fields": [
         {
          "fieldName": "encounterCount"
         },
         {
          "fieldName": "sourceName"
         }
        ]
       },
       "data": {
        "queryName": "main_query"
       }
